local function setStatus(text, active)
	statusLabel.Text = text
	tween(statusDot, { BackgroundColor3 = active and C.accent or C.muted })
end

local function setAutoUI(enabled)
	if enabled then
		autoBtn.Text = "Enabled"
		tween(autoBtn, { BackgroundColor3 = C.accentBg, TextColor3 = C.accent })
		tween(autoStroke, { Color = C.accent, Transparency = 0.4 })
	else
		autoBtn.Text = "Disabled"
		tween(autoBtn, { BackgroundColor3 = C.inset, TextColor3 = C.subtext })
		tween(autoStroke, { Color = C.border, Transparency = 0 })
	end
end

local function claimAllGifts()
	if state.claiming then
		return
	end
	state.claiming = true
	setStatus("Claiming...", false)

	local ok, inbox = pcall(function()
		return Networking.Mailbox.OpenInbox:Fire()
	end)

	if not ok or not inbox then
		setStatus("Failed to open inbox", false)
		state.claiming = false
		return
	end

	local count = 0
	for giftId in pairs(inbox) do
		local claimed = pcall(function()
			Networking.Mailbox.Claim:Fire(giftId)
		end)
		if claimed then
			count += 1
		end
		task.wait()
	end

	state.claiming = false
	setStatus(("Claimed %d gift%s"):format(count, count == 1 and "" or "s"), true)

	task.delay(3, function()
		if statusLabel.Text:find("Claimed") then
			setStatus("Ready", false)
		end
	end)
end

local function startAutoLoop()
	task.spawn(function()
		while getgenv().AutoClaim do
			claimAllGifts()
			task.wait(state.interval)
		end
	end)
end

local function hover(button, base, target)
	button.MouseEnter:Connect(function()
		if button.BackgroundColor3 == base then
			tween(button, { BackgroundColor3 = target })
		end
	end)
	button.MouseLeave:Connect(function()
		if button.BackgroundColor3 == target then
			tween(button, { BackgroundColor3 = base })
		end
	end)
end

hover(claimBtn, C.accent, Color3.fromRGB(72, 221, 168))

claimBtn.MouseButton1Click:Connect(claimAllGifts)

autoBtn.MouseButton1Click:Connect(function()
	getgenv().AutoClaim = not getgenv().AutoClaim
	setAutoUI(getgenv().AutoClaim)
	if getgenv().AutoClaim then
		startAutoLoop()
	end
end)

intervalBox.FocusLost:Connect(function()
	local n = tonumber(intervalBox.Text)
	if n and n > 0 then
		state.interval = n
	end
	intervalBox.Text = tostring(state.interval)
end)

do
	local dragging, dragStart, startPos

	header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = card.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			card.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

setAutoUI(getgenv().AutoClaim)
if getgenv().AutoClaim then
	startAutoLoop()
end
